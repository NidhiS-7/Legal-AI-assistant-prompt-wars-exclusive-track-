# Copy this file to .env and fill in your own key. Never commit the real .env file.
# Get a free key at https://aistudio.google.com/app/apikey (no credit card required)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional: override the default model
GEMINI_MODEL=gemini-2.0-flash

# Optional: max upload size in MB (default 8)
MAX_UPLOAD_MB=8
